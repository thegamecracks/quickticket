# BACKEND__ROOT_PATH=/backend
BACKEND__CACHE__URL=sqlite:///quickticket-cache.db
BACKEND__DB__URL=sqlite+aiosqlite:///quickticket.db
BACKEND__FRONTEND__BUILTIN=1
BACKEND__FRONTEND__DEFAULT_REDIRECT_URI=http://127.0.0.1:5173/
BACKEND__FRONTEND__REDIRECT_URIS=["http://127.0.0.1:5173/*", "http://localhost:5173/*"]
BACKEND__LOG__DEBUG=1
BACKEND__LOG__PROFILING=1
BACKEND__LOG__VERBOSITY=3
BACKEND__OPENAPI__URL=/openapi.json
BACKEND__OPENAPI__SWAGGER_URL=/docs
BACKEND__OPENAPI__REDOC_URL=/redoc
# # The client ID, secret, and discovery URL are required for authentication
# BACKEND__OPENID__CLIENT_ID=abc123
# BACKEND__OPENID__CLIENT_SECRET=abc123
# BACKEND__OPENID__DISCOVERY_URL=https://example.com/.well-known/openid-configuration
# # Admin group is optional if your provider adds a "groups" claim in its ID tokens
# BACKEND__OPENID__ADMIN_GROUP=admins
BACKEND__SECURITY__ALLOWED_HOSTS=["127.0.0.1", "localhost"]
BACKEND__SECURITY__TRUSTED_PROXIES=["127.0.0.1"]
BACKEND__SECURITY__CSRF_SECRET=insecure_qt9u0SCF3DuSJ69ZrqvzlJGTWxx7C5wh
BACKEND__SECURITY__COOKIE_ENCRYPTION_SECRETS=["Qfw1bmzNtFba8qLxYZzxtEDfgd4P58LCDKiuMezO6lU="]
BACKEND__SECURITY__TOKEN_LEEWAY=30
BACKEND__SMTP__HOST=example.com
BACKEND__SMTP__PORT=465
# BACKEND__SMTP__TLS=implicit
BACKEND__SMTP__USERNAME=user@example.com
BACKEND__SMTP__PASSWORD=abc123
BACKEND__SMTP__FROM_EMAIL=User Name <user@example.com>
